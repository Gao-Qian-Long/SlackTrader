{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "蓝牙助手",
  "version": "0.6.0",
  "identifier": "com.bluetoothassistant.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "蓝牙助手",
        "width": 232,
        "height": 28,
        "minWidth": 220,
        "minHeight": 24,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "蓝牙助手",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxQUMxRURDMURFRDg2NzkKUldSNWh1MGQzQjZzWVhyTW9RSWFVY1llOGM3RVU3L1MzZW5wWmg2UXZtaXhpd0dRZVhyOWZtQXoK",
      "endpoints": [
        "https://github.com/Gao-Qian-Long/SlackTrader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
